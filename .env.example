# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Alert recipients
ALERT_MOBILE_NUMBER=
